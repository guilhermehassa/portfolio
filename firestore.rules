rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null
        && request.auth.uid == 'Yc7qwiq4tPcRpw4tgtrw3VfxOOh1'
        && request.auth.uid == userId;
    }

    match /users/{userId}/days/{date} {
      allow read, write: if owner(userId);
    }
    match /users/{userId}/expenses/{expenseId} {
      allow read, write: if owner(userId);
    }
    match /users/{userId}/categories/{categoryId} {
      allow read, write: if owner(userId);
    }
    match /users/{userId}/goals/{month} {
      allow read, write: if owner(userId);
    }
    match /users/{userId}/plannedExpenses/{plannedExpenseId} {
      allow read, write: if owner(userId);
    }
    match /users/{userId}/costProfiles/{profileId} {
      allow read, write: if owner(userId);
    }
  }
}
